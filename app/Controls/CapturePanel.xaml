<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Transom.Controls.CapturePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="340" Spacing="10">
        <Grid>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Capture" />
            <TextBlock
                x:Name="Info"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Border
            MaxHeight="220"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="8">
            <Image x:Name="Preview" Stretch="Uniform" />
        </Border>
        <TextBlock
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Already copied to your clipboard." />

        <Grid ColumnSpacing="6" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Grid.Row="2" HorizontalAlignment="Stretch" Click="Edit_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xEE56;" />
                    <TextBlock Text="Draw and mark up" />
                </StackPanel>
            </Button>
            <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Click="PickColor_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xEF3C;" />
                    <TextBlock Text="Pick a color" />
                </StackPanel>
            </Button>
            <Button
                Grid.Row="3"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                IsEnabled="False"
                ToolTipService.ToolTip="Coming with the AI features">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xF2B7;" />
                    <TextBlock Text="Translate text · coming soon" />
                </StackPanel>
            </Button>
            <Button x:Name="CopyTextButton" HorizontalAlignment="Stretch" Click="CopyText_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8C1;" />
                    <TextBlock Text="Copy text" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="Save_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE74E;" />
                    <TextBlock Text="Save" />
                </StackPanel>
            </Button>
            <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="AddToShelf_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE7B8;" />
                    <TextBlock Text="Add to shelf" />
                </StackPanel>
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="NewCapture_Click"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE722;" />
                    <TextBlock Text="New capture" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock
            x:Name="Status"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <HyperlinkButton
            x:Name="ShowInFolderLink"
            Padding="0"
            Click="ShowInFolder_Click"
            Content="Show in folder"
            Visibility="Collapsed" />
        <TextBox
            x:Name="OcrText" AutomationProperties.Name="Text in the screenshot"
            MaxHeight="160"
            AcceptsReturn="True"
            IsReadOnly="True"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
