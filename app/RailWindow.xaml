<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Transom.RailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Transom.Controls"
    xmlns:models="using:Transom.Models"
    Title="Transom">
    <Window.SystemBackdrop>
        <controls:RailBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,1,0">
        <Grid.Resources>
            <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />

            <Style x:Key="Slot" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="ToolTipService.Placement" Value="Right" />
            </Style>
            <Style x:Key="Glyph" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="StrokeThickness" Value="1.6" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
            </Style>
            <Style x:Key="ClipItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <DataTemplate x:Key="ClipTemplate" x:DataType="models:ClipRow">
                <Grid Padding="0,6" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <Grid>
                            <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" Visibility="{x:Bind GlyphVisibility}" />
                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" Visibility="{x:Bind ThumbnailVisibility}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock MaxLines="2" Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PinClip_Click"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="{x:Bind PinTip}">
                            <FontIcon FontSize="13" Glyph="{x:Bind PinGlyph}" Foreground="{x:Bind PinBrush}" />
                        </Button>
                        <Button
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="DeleteClip_Click"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="Delete">
                            <FontIcon FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <Style x:Key="Sep" TargetType="Rectangle">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="TopSlots" Padding="0,6,0,0" Spacing="2">
            <Button x:Name="ArtButton" Style="{StaticResource Slot}" ToolTipService.ToolTip="Nothing playing">
                <Grid x:Name="ArtHost" Width="28" Height="28">
                    <Border
                        x:Name="ArtPlaceholder"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource Glyph}" Data="M9 18 L9 5 L21 3 L21 16 M9 18 A3 3 0 1 1 3 18 A3 3 0 1 1 9 18 Z M21 16 A3 3 0 1 1 15 16 A3 3 0 1 1 21 16 Z" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <Border
                        x:Name="ArtFrame"
                        HorizontalAlignment="Center"
                        Background="Black"
                        VerticalAlignment="Center"
                        CornerRadius="5"
                        Visibility="Collapsed">
                        <Border
                            x:Name="ArtPoster"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="5">
                            <Border.Background>
                                <ImageBrush x:Name="ArtImage" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>
                </Grid>
                <Button.Flyout>
                    <Flyout
                        x:Name="MediaFlyout"
                        Closed="MediaFlyout_Closed"
                        Opened="MediaFlyout_Opened"
                        Placement="RightEdgeAlignedTop"
                        ShouldConstrainToRootBounds="False">
                        <StackPanel Width="340">
                            <StackPanel.Resources>
                                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                <Style x:Key="MediaRound" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                    <Setter Property="Width" Value="40" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="20" />
                                </Style>
                            </StackPanel.Resources>

                            <Border
                                x:Name="FlyArt"
                                Width="340"
                                Height="191"
                                Background="Black"
                                CornerRadius="8">
                                <Grid>
                                    <Border
                                        x:Name="FlyPoster"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                        <Border.Background>
                                            <ImageBrush x:Name="FlyArtImage" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Viewbox x:Name="FlyNoArt" Width="40" Height="40">
                                        <Canvas Width="24" Height="24">
                                            <Path
                                                Data="M9 18 L9 5 L21 3 L21 16 M9 18 A3 3 0 1 1 3 18 A3 3 0 1 1 9 18 Z M21 16 A3 3 0 1 1 15 16 A3 3 0 1 1 21 16 Z"
                                                Stroke="#80FFFFFF"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.4" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <TextBlock
                                x:Name="FlyTitle"
                                Margin="2,14,2,0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="Nothing playing"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="FlyArtist"
                                Margin="2,2,2,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />

                            <Grid
                                x:Name="FlyTimeline"
                                Margin="2,14,2,0"
                                RowSpacing="6"
                                Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ProgressBar x:Name="FlyProgress" Maximum="1" />
                                <TextBlock
                                    x:Name="FlyElapsed"
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock
                                    x:Name="FlyDuration"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>

                            <StackPanel
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="16">
                                <Button
                                    x:Name="FlyPrevious"
                                    VerticalAlignment="Center"
                                    Click="Previous_Click"
                                    Style="{StaticResource MediaRound}"
                                    ToolTipService.ToolTip="Previous">
                                    <FontIcon FontSize="16" Glyph="&#xE892;" />
                                </Button>
                                <Button
                                    x:Name="FlyPlayPause"
                                    Width="52"
                                    Height="52"
                                    Padding="0"
                                    Click="PlayPause_Click"
                                    CornerRadius="26">
                                    <Button.Resources>
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TextFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ControlFillColorDisabledBrush" />
                                        <StaticResource x:Key="ButtonForeground" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SolidBackgroundFillColorBaseBrush" />
                                    </Button.Resources>
                                    <FontIcon x:Name="FlyPlayGlyph" FontSize="18" Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    x:Name="FlyNext"
                                    VerticalAlignment="Center"
                                    Click="Next_Click"
                                    Style="{StaticResource MediaRound}"
                                    ToolTipService.ToolTip="Next">
                                    <FontIcon FontSize="16" Glyph="&#xE893;" />
                                </Button>
                            </StackPanel>

                            <TextBlock
                                x:Name="FlySource"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button
                x:Name="PlayButton"
                Click="PlayPause_Click"
                IsEnabled="False"
                Style="{StaticResource Slot}"
                ToolTipService.ToolTip="Play">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="PlayGlyph" Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M7 4.5 L7 19.5 L20 12 Z" />
                        <Path
                            x:Name="PauseGlyph"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            Data="M6 4.5 L10 4.5 L10 19.5 L6 19.5 Z M14 4.5 L18 4.5 L18 19.5 L14 19.5 Z"
                            Visibility="Collapsed" />
                    </Canvas>
                </Viewbox>
            </Button>

            <Rectangle Style="{StaticResource Sep}" />

            <Button Opacity="0.45" Style="{StaticResource Slot}" ToolTipService.ToolTip="Ask AI · coming soon">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource Glyph}" Data="M12 3 L13.9 8.1 L19 10 L13.9 11.9 L12 17 L10.1 11.9 L5 10 L10.1 8.1 Z M19 2 L19 6 M17 4 L21 4 M5 17 L5 21 M3 19 L7 19" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="ClipboardButton" Style="{StaticResource Slot}" ToolTipService.ToolTip="Clipboard history (Win+Alt+V)">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource Glyph}" Data="M9 2 L15 2 A1 1 0 0 1 16 3 L16 5 A1 1 0 0 1 15 6 L9 6 A1 1 0 0 1 8 5 L8 3 A1 1 0 0 1 9 2 Z M16 4 L18 4 A2 2 0 0 1 20 6 L20 20 A2 2 0 0 1 18 22 L6 22 A2 2 0 0 1 4 20 L4 6 A2 2 0 0 1 6 4 L8 4" />
                    </Canvas>
                </Viewbox>
                <Button.Flyout>
                    <Flyout
                        x:Name="ClipboardFlyout"
                        Closed="ClipboardFlyout_Closed"
                        Opened="ClipboardFlyout_Opened"
                        Placement="RightEdgeAlignedTop"
                        ShouldConstrainToRootBounds="False">
                        <StackPanel Width="340" Spacing="8">
                            <Grid>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Clipboard" />
                                <HyperlinkButton
                                    Padding="6,2"
                                    HorizontalAlignment="Right"
                                    Click="ClearClipboard_Click"
                                    Content="Clear"
                                    ToolTipService.ToolTip="Remove everything except pinned items" />
                            </Grid>
                            <TextBox x:Name="ClipSearch" PlaceholderText="Search clipboard" TextChanged="ClipSearch_TextChanged" />
                            <SelectorBar x:Name="ClipFilter" SelectionChanged="ClipFilter_SelectionChanged">
                                <SelectorBarItem IsSelected="True" Tag="all" Text="All" />
                                <SelectorBarItem Tag="text" Text="Text" />
                                <SelectorBarItem Tag="link" Text="Links" />
                                <SelectorBarItem Tag="image" Text="Images" />
                                <SelectorBarItem Tag="pinned" Text="Pinned" />
                            </SelectorBar>
                            <ScrollViewer MaxHeight="440">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="PinnedHeader"
                                        Margin="4,6,0,2"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Pinned" />
                                    <ListView
                                        x:Name="PinnedList"
                                        ItemContainerStyle="{StaticResource ClipItemStyle}"
                                        IsItemClickEnabled="True"
                                        ItemClick="Clip_ItemClick"
                                        ItemTemplate="{StaticResource ClipTemplate}"
                                        SelectionMode="None" />
                                    <TextBlock
                                        x:Name="RecentHeader"
                                        Margin="4,6,0,2"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Recent" />
                                    <ListView
                                        x:Name="RecentList"
                                        ItemContainerStyle="{StaticResource ClipItemStyle}"
                                        IsItemClickEnabled="True"
                                        ItemClick="Clip_ItemClick"
                                        ItemTemplate="{StaticResource ClipTemplate}"
                                        SelectionMode="None" />
                                    <TextBlock
                                        x:Name="ClipEmpty"
                                        Margin="4,8"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Things you copy will show up here."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Click to paste into your last app · Win+Alt+V opens this · Passwords are never saved"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="ConvertButton" Style="{StaticResource Slot}" ToolTipService.ToolTip="Convert currency, units and time zones">
                <Grid>
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource Glyph}" Data="M8 3 L4 7 L8 11 M4 7 L20 7 M16 21 L20 17 L16 13 M20 17 L4 17" />
                        </Canvas>
                    </Viewbox>
                    <Border
                        x:Name="ConvertBadge"
                        Height="14"
                        MinWidth="14"
                        Margin="0,-6,-8,0"
                        Padding="3,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="7"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="ConvertBadgeText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
                <Button.Flyout>
                    <Flyout
                        x:Name="ConvertFlyout"
                        Closed="ConvertFlyout_Closed"
                        Opened="ConvertFlyout_Opened"
                        Placement="RightEdgeAlignedTop"
                        ShouldConstrainToRootBounds="False">
                        <controls:ConvertPanel x:Name="ConvertPanelView" />
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Rectangle Style="{StaticResource Sep}" />

            <Button Opacity="0.45" Style="{StaticResource Slot}" ToolTipService.ToolTip="Quick notes · coming soon">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource Glyph}" Data="M12 3 L5 3 A2 2 0 0 0 3 5 L3 19 A2 2 0 0 0 5 21 L19 21 A2 2 0 0 0 21 19 L21 12 M18.4 2.6 A2.1 2.1 0 0 1 21.4 5.6 L12.4 14.6 L8.5 15.5 L9.4 11.6 Z" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button Opacity="0.45" Style="{StaticResource Slot}" ToolTipService.ToolTip="Shelf · coming soon">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource Glyph}" Data="M22 12 L16 12 L14 15 L10 15 L8 12 L2 12 M5.5 5.1 L2 12 L2 18 A2 2 0 0 0 4 20 L20 20 A2 2 0 0 0 22 18 L22 12 L18.5 5.1 A2 2 0 0 0 16.8 4 L7.2 4 A2 2 0 0 0 5.5 5.1 Z" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button Opacity="0.45" Style="{StaticResource Slot}" ToolTipService.ToolTip="Capture · coming soon">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource Glyph}" Data="M3 7 L3 5 A2 2 0 0 1 5 3 L7 3 M17 3 L19 3 A2 2 0 0 1 21 5 L21 7 M21 17 L21 19 A2 2 0 0 1 19 21 L17 21 M7 21 L5 21 A2 2 0 0 1 3 19 L3 17 M15.5 12 A3.5 3.5 0 1 1 8.5 12 A3.5 3.5 0 1 1 15.5 12 Z" />
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>

        <StackPanel x:Name="BottomSlots" Grid.Row="2" Padding="0,0,0,6" Spacing="2">
            <Button x:Name="AwakeButton" Style="{StaticResource Slot}" ToolTipService.ToolTip="Keep awake">
                <Grid>
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="AwakeGlyph" Style="{StaticResource Glyph}" Data="M10 2 L10 4 M14 2 L14 4 M6 2 L6 4 M16 8 A1 1 0 0 1 17 9 L17 17 A4 4 0 0 1 13 21 L7 21 A4 4 0 0 1 3 17 L3 9 A1 1 0 0 1 4 8 L18 8 A4 4 0 1 1 18 16 L17 16" />
                    </Canvas>
                </Viewbox>
                <Border
                    x:Name="AwakeBadge"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Height="14"
                    Margin="0,0,-8,-6"
                    Padding="3,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    CornerRadius="7"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="AwakeBadgeText"
                        VerticalAlignment="Center"
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                </Grid>
                <Button.Flyout>
                    <Flyout
                        x:Name="AwakeFlyout"
                        Placement="RightEdgeAlignedBottom"
                        ShouldConstrainToRootBounds="False">
                        <StackPanel Width="340" Spacing="10">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Keep awake" />
                                <ToggleSwitch
                                    x:Name="AwakeToggle"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="AwakeToggle_Toggled" />
                            </Grid>
                            <TextBlock
                                x:Name="AwakeStatus"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Your PC sleeps as usual."
                                TextWrapping="Wrap" />
                            <RadioButtons x:Name="AwakeDuration" MaxColumns="2" SelectedIndex="1" SelectionChanged="AwakeDuration_SelectionChanged">
                                <x:String>30 min</x:String>
                                <x:String>1 hour</x:String>
                                <x:String>2 hours</x:String>
                                <x:String>Until I stop it</x:String>
                            </RadioButtons>
                            <CheckBox
                                x:Name="AwakeScreen"
                                Checked="AwakeScreen_Changed"
                                Content="Keep the screen on too"
                                Unchecked="AwakeScreen_Changed" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="RemindersButton" Style="{StaticResource Slot}" ToolTipService.ToolTip="Reminders">
                <Grid>
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="RemindersGlyph" Style="{StaticResource Glyph}" Data="M6 8 A6 6 0 0 1 18 8 C18 15 21 17 21 17 L3 17 C3 17 6 15 6 8 M10.3 21 A1.94 1.94 0 0 0 13.7 21" />
                        </Canvas>
                    </Viewbox>
                    <Border
                        x:Name="RemindersBadge"
                        Height="14"
                        Margin="0,0,-8,-6"
                        Padding="3,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="7"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="RemindersBadgeText"
                            VerticalAlignment="Center"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
                <Button.Flyout>
                    <Flyout
                        x:Name="RemindersFlyout"
                        Opened="RemindersFlyout_Opened"
                        Placement="RightEdgeAlignedBottom"
                        ShouldConstrainToRootBounds="False">
                        <StackPanel Width="340" Spacing="10">
                            <Grid>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Reminders" />
                                <TextBlock
                                    x:Name="RemindersCount"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                            <TextBox x:Name="ReminderText" KeyDown="ReminderText_KeyDown" PlaceholderText="Remind me to…" />
                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button HorizontalAlignment="Stretch" Click="AddReminder_Click" Content="In 5 min" Tag="5" />
                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="AddReminder_Click" Content="In 20 min" Tag="20" />
                                <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="AddReminder_Click" Content="In 1 hour" Tag="60" />
                                <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="AddReminder_Click" Content="Tomorrow 9 AM" Tag="tomorrow" />
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="At" /><TimePicker x:Name="ReminderTime" MinWidth="0" MinuteIncrement="5" /></StackPanel>
                                <Button Grid.Column="1" Click="AddReminder_Click" Content="Add" Style="{StaticResource AccentButtonStyle}" Tag="at" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock
                                x:Name="RemindersEmpty"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="No reminders yet. Type what to remember, then pick a time."
                                TextWrapping="Wrap" />
                            <ScrollViewer MaxHeight="260">
                                <ItemsControl x:Name="RemindersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ReminderRow">
                                            <Grid Padding="0,6" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Click="CompleteReminder_Click"
                                                    CornerRadius="11"
                                                    Tag="{x:Bind Id}"
                                                    ToolTipService.ToolTip="Mark done">
                                                    <FontIcon FontSize="10" Glyph="&#xE73E;" />
                                                </Button>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock MaxLines="2" Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind When}" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="2"
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="DeleteReminder_Click"
                                                    Tag="{x:Bind Id}"
                                                    ToolTipService.ToolTip="Delete">
                                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Rectangle Style="{StaticResource Sep}" />

            <Button Style="{StaticResource Slot}" ToolTipService.ToolTip="Transom menu">
                <Viewbox Width="24" Height="24" Tag="logo">
                    <Canvas Width="48" Height="48">
                        <Rectangle Canvas.Left="1" Canvas.Top="1" Width="12" Height="46" Fill="#2F6BFF" RadiusX="6" RadiusY="6" />
                        <Ellipse Canvas.Left="4.4" Canvas.Top="6.4" Width="5.2" Height="5.2" Fill="#0B1F5C" />
                        <Ellipse Canvas.Left="4.4" Canvas.Top="36.4" Width="5.2" Height="5.2" Fill="#0B1F5C" />
                        <Ellipse Canvas.Left="3.6" Canvas.Top="20.6" Width="6.8" Height="6.8" Fill="White" />
                        <Path Data="M17 2 A22 22 0 0 1 17 46 Z" Fill="#34D8A9" Stroke="#13A07A" StrokeThickness="1" />
                        <Ellipse Canvas.Left="25.4" Canvas.Top="19.4" Width="9.2" Height="9.2" Fill="#2F6BFF" />
                        <Ellipse Canvas.Left="21.4" Canvas.Top="8.4" Width="7.2" Height="7.2" Fill="#2F6BFF" />
                        <Ellipse Canvas.Left="22.4" Canvas.Top="33.4" Width="7.2" Height="7.2" Fill="#2F6BFF" />
                        <Ellipse Canvas.Left="40.5" Canvas.Top="10" Width="6" Height="6" Fill="#2F6BFF" />
                        <Ellipse Canvas.Left="39.6" Canvas.Top="34.1" Width="4.8" Height="4.8" Fill="#2F6BFF" />
                    </Canvas>
                </Viewbox>
                <Button.Flyout>
                    <MenuFlyout Placement="Right" ShouldConstrainToRootBounds="False">
                        <MenuFlyoutItem Click="Settings_Click" Text="Settings"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="Quit_Click" Text="Quit Transom"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</Window>
