<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Transom.CaptureEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit capture">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="ToolButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinWidth" Value="40" />
            </Style>
            <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Edit capture">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="16,4,16,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="PenTool" AutomationProperties.Name="Pen" Click="Tool_Click" Style="{StaticResource ToolButton}" Tag="pen" ToolTipService.ToolTip="Pen">
                    <FontIcon FontSize="16" Glyph="&#xEE56;" />
                </ToggleButton>
                <ToggleButton x:Name="HighlighterTool" AutomationProperties.Name="Highlighter" Click="Tool_Click" Style="{StaticResource ToolButton}" Tag="highlighter" ToolTipService.ToolTip="Highlighter">
                    <FontIcon FontSize="16" Glyph="&#xE7E6;" />
                </ToggleButton>
                <ToggleButton x:Name="RectangleTool" AutomationProperties.Name="Rectangle" Click="Tool_Click" Style="{StaticResource ToolButton}" Tag="rectangle" ToolTipService.ToolTip="Rectangle">
                    <FontIcon FontSize="16" Glyph="&#xE739;" />
                </ToggleButton>
                <ToggleButton x:Name="ArrowTool" AutomationProperties.Name="Arrow" Click="Tool_Click" Style="{StaticResource ToolButton}" Tag="arrow" ToolTipService.ToolTip="Arrow">
                    <FontIcon FontSize="16" Glyph="&#xE76C;" />
                </ToggleButton>
                <ToggleButton x:Name="PickerTool" AutomationProperties.Name="Pick a color" Click="Tool_Click" Style="{StaticResource ToolButton}" Tag="picker" ToolTipService.ToolTip="Pick a color from the screenshot">
                    <FontIcon FontSize="16" Glyph="&#xEF3C;" />
                </ToggleButton>
            </StackPanel>

            <StackPanel x:Name="Swatches" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Border
                    x:Name="PickedSwatch"
                    Width="28"
                    Height="28"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed" />
                <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button AutomationProperties.Name="Undo" Click="Undo_Click" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                </Button>
                <Button Click="Clear_Click" Content="Clear" />
                <Button Click="Copy_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <Button Click="Done_Click" Content="Done" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Padding="16,0,16,16">
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                <Viewbox x:Name="Fit" Margin="12" Stretch="Uniform" StretchDirection="DownOnly">
                    <Grid x:Name="Surface">
                        <Image x:Name="Picture" Stretch="Fill" />
                        <Canvas
                            x:Name="Ink"
                            Background="Transparent"
                            PointerMoved="Ink_PointerMoved"
                            PointerPressed="Ink_PointerPressed"
                            PointerReleased="Ink_PointerReleased" />
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</Window>
