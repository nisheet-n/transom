<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Transom.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Transom.Models"
    Title="Transom Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,4,0,14" />
            </Style>
            <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,18,0,4" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="NavColumn" Grid.RowSpan="2">
            <Grid.Resources>
                <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            </Grid.Resources>
            <Canvas x:Name="NavCanvas" />
            <ScrollViewer x:Name="NavScroll" Padding="0,44,0,12" Visibility="Collapsed">
                <StackPanel x:Name="NavStack" Spacing="2" />
            </ScrollViewer>
        </Grid>

        <TitleBar x:Name="AppTitleBar" Grid.Column="1" Title="Transom Settings">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="8,0,0,0">
            <ScrollViewer>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40*" MaxWidth="884" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="Pages" Grid.Column="1" Padding="32,8,32,32">

                    <StackPanel x:Name="GeneralPage" Spacing="6">
                        <TextBlock Style="{StaticResource PageTitle}" Text="General" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Start Transom with Windows" />
                                    <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" Text="Open Transom automatically when you sign in." />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" AutomationProperties.Name="Start Transom with Windows" Grid.Column="1" MinWidth="0" Toggled="StartupToggle_Toggled" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource GroupTitle}" Text="Keyboard" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Keyboard navigation" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Ctrl+Alt+1 to 9 opens the rail's items in order, from the first to the ninth." />
                                </StackPanel>
                                <ToggleSwitch x:Name="NavToggle" AutomationProperties.Name="Keyboard navigation" Grid.Column="1" MinWidth="0" Toggled="NavToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Shortcuts" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontFamily="Cascadia Mono, Consolas" Text="Win+Alt+V" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="Open clipboard history" />
                                    <TextBlock Grid.Row="1" FontFamily="Cascadia Mono, Consolas" Text="Win+Alt+N" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Text="Open quick notes" />
                                    <TextBlock Grid.Row="2" FontFamily="Cascadia Mono, Consolas" Text="Ctrl+Alt+1…9" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" Text="Open rail items in order (when keyboard navigation is on)" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AppearancePage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Appearance" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Rail background" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Changes show on the rail right away." />
                        <GridView
                            x:Name="StyleGrid"
                            ItemsSource="{x:Bind Styles}"
                            SelectionChanged="StyleGrid_SelectionChanged"
                            SelectionMode="Single">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:StyleOption">
                                    <StackPanel Width="164" Padding="6" Spacing="6">
                                        <Border
                                            Height="60"
                                            Background="{x:Bind Swatch}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6" />
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                        <TextBlock
                                            Height="34"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Hint}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <StackPanel x:Name="PresetPanel" Margin="0,8,0,0" Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Preset color" />
                            <GridView
                                x:Name="PresetGrid"
                                ItemsSource="{x:Bind Presets}"
                                SelectionChanged="PresetGrid_SelectionChanged"
                                SelectionMode="Single">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PresetOption">
                                        <StackPanel Width="72" Padding="4" Spacing="6">
                                            <Ellipse
                                                Width="40"
                                                Height="40"
                                                HorizontalAlignment="Center"
                                                Fill="{x:Bind Swatch}"
                                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}" />
                                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>

                        <Border x:Name="CustomPanel" Margin="0,8,0,0" Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Custom color" />
                                <ColorPicker
                                    x:Name="CustomPicker"
                                    ColorChanged="CustomPicker_ColorChanged"
                                    IsAlphaEnabled="False"
                                    IsColorChannelTextInputVisible="False"
                                    IsHexInputVisible="True"
                                    IsMoreButtonVisible="False" />
                                <Slider
                                    x:Name="OpacitySlider"
                                    Header="Opacity"
                                    Maximum="100"
                                    Minimum="10"
                                    StepFrequency="5"
                                    ValueChanged="OpacitySlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource GroupTitle}" Text="Icons" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <StackPanel>
                                    <TextBlock Text="Icon color" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Automatic follows light and dark. Changes show on the rail right away." />
                                </StackPanel>
                                <StackPanel x:Name="IconColorSwatches" Orientation="Horizontal" Spacing="8" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Icon size" />
                                    <TextBlock Style="{StaticResource Hint}" Text="How large the icons are inside their slots." />
                                </StackPanel>
                                <ComboBox x:Name="IconSizeBox" Grid.Column="1" MinWidth="120" VerticalAlignment="Center" AutomationProperties.Name="Icon size" SelectionChanged="IconSizeBox_SelectionChanged">
                                    <x:String>Small</x:String>
                                    <x:String>Medium</x:String>
                                    <x:String>Large</x:String>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Badges use the icon color" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Otherwise badges, like Convert's currency sign, use your accent color." />
                                </StackPanel>
                                <ToggleSwitch x:Name="BadgeColorToggle" Grid.Column="1" MinWidth="0" AutomationProperties.Name="Badges use the icon color" Toggled="BadgeColorToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Separators" />
                                    <TextBlock Style="{StaticResource Hint}" Text="The thin lines between groups of tools." />
                                </StackPanel>
                                <ToggleSwitch x:Name="SeparatorsToggle" Grid.Column="1" MinWidth="0" AutomationProperties.Name="Separators" Toggled="SeparatorsToggle_Toggled" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource GroupTitle}" Text="More" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Rail theme" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Light or dark rail and icons. Follow taskbar uses your Windows mode." />
                                </StackPanel>
                                <ComboBox
                                    x:Name="ThemeBox" AutomationProperties.Name="Rail theme"
                                    Grid.Column="1"
                                    MinWidth="160"
                                    VerticalAlignment="Center"
                                    SelectionChanged="ThemeBox_SelectionChanged">
                                    <x:String>Follow taskbar</x:String>
                                    <x:String>Light</x:String>
                                    <x:String>Dark</x:String>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Go solid on battery saver" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Turns off transparency to save power, like Windows does." />
                                </StackPanel>
                                <ToggleSwitch x:Name="BatteryToggle" AutomationProperties.Name="Go solid on battery saver" Grid.Column="1" MinWidth="0" Toggled="BatteryToggle_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DockPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Dock" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Where the rail sits" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="The rail matches your taskbar's thickness on every edge. Panels open toward the middle of the screen." />
                        <GridView x:Name="DockGrid" SelectionChanged="DockGrid_SelectionChanged" SelectionMode="Single">
                            <GridViewItem AutomationProperties.Name="Left" Tag="left">
                                <StackPanel Width="150" Padding="6" Spacing="8">
                                    <Grid Height="84" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <Rectangle Width="14" HorizontalAlignment="Left" Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="3" RadiusY="3" Margin="4" />
                                    </Grid>
                                    <TextBlock HorizontalAlignment="Center" Text="Left" />
                                </StackPanel>
                            </GridViewItem>
                            <GridViewItem AutomationProperties.Name="Right" Tag="right">
                                <StackPanel Width="150" Padding="6" Spacing="8">
                                    <Grid Height="84" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <Rectangle Width="14" HorizontalAlignment="Right" Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="3" RadiusY="3" Margin="4" />
                                    </Grid>
                                    <TextBlock HorizontalAlignment="Center" Text="Right" />
                                </StackPanel>
                            </GridViewItem>
                            <GridViewItem AutomationProperties.Name="Top" Tag="top">
                                <StackPanel Width="150" Padding="6" Spacing="8">
                                    <Grid Height="84" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <Rectangle Height="12" VerticalAlignment="Top" Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="3" RadiusY="3" Margin="4" />
                                    </Grid>
                                    <TextBlock HorizontalAlignment="Center" Text="Top" />
                                </StackPanel>
                            </GridViewItem>
                            <GridViewItem AutomationProperties.Name="Bottom" Tag="bottom">
                                <StackPanel Width="150" Padding="6" Spacing="8">
                                    <Grid Height="84" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                        <Rectangle Height="12" VerticalAlignment="Bottom" Fill="{ThemeResource AccentFillColorDefaultBrush}" RadiusX="3" RadiusY="3" Margin="4" />
                                    </Grid>
                                    <TextBlock HorizontalAlignment="Center" Text="Bottom" />
                                </StackPanel>
                            </GridViewItem>
                        </GridView>

                        <TextBlock Style="{StaticResource GroupTitle}" Text="Top and bottom docks" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show live details" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Slots grow to show their value right on the rail: a conversion like $100 → ₹9,511, the song that's playing, Keep awake's time left and your next reminder." />
                                </StackPanel>
                                <ToggleSwitch x:Name="LiveDetailsToggle" Grid.Column="1" MinWidth="0" AutomationProperties.Name="Show live details" Toggled="LiveDetailsToggle_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ToolsPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Tools" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Show on the rail" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Turn off the tools you don't use to keep the rail short." />
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="ToolToggles" Spacing="2" />
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="MediaPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Media" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Shows what's playing in any app, with artwork, play and pause, skip and a timeline. During a call, call controls appear just above it." />
                    </StackPanel>

                    <StackPanel x:Name="VolumePage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Volume" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Change the volume of everything, or of each app that's playing. Scroll over the Volume icon to change it without opening anything." />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Scroll step" />
                                    <TextBlock Style="{StaticResource Hint}" Text="How much one notch of the mouse wheel changes the volume." />
                                </StackPanel>
                                <ComboBox x:Name="VolumeStepBox" AutomationProperties.Name="Scroll step" Grid.Column="1" MinWidth="120" VerticalAlignment="Center" SelectionChanged="VolumeStepBox_SelectionChanged">
                                    <x:String>1%</x:String>
                                    <x:String>2%</x:String>
                                    <x:String>5%</x:String>
                                    <x:String>10%</x:String>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AiPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Selected text and AI" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Select text in any app to copy it, save it as a note or search the web. AI actions like rewrite and summarize are coming soon." />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Notice selected text" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Reads the text you select in other apps so prices and units light up Convert and these actions are ready. Nothing is saved or sent anywhere, and password fields are skipped. Some apps, like VS Code, hide their text, so there Transom copies the selection for a moment and puts your clipboard back." />
                                </StackPanel>
                                <ToggleSwitch x:Name="SelectionToggle" AutomationProperties.Name="Notice selected text" Grid.Column="1" MinWidth="0" Toggled="SelectionToggle_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ClipboardPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Clipboard history" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Everything you copy, ready to paste again. Win+Alt+V opens it from anywhere. Passwords from password managers are never saved." />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="History size" />
                                    <TextBlock Style="{StaticResource Hint}" Text="How many recent items to keep. Pinned items are always kept." />
                                </StackPanel>
                                <ComboBox x:Name="ClipLimitBox" AutomationProperties.Name="History size" Grid.Column="1" MinWidth="120" VerticalAlignment="Center" SelectionChanged="ClipLimitBox_SelectionChanged">
                                    <x:String>25 items</x:String>
                                    <x:String>50 items</x:String>
                                    <x:String>100 items</x:String>
                                    <x:String>200 items</x:String>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Clear history when Transom quits" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Pinned items stay." />
                                </StackPanel>
                                <ToggleSwitch x:Name="ClearOnQuitToggle" AutomationProperties.Name="Clear history when Transom quits" Grid.Column="1" MinWidth="0" Toggled="ClearOnQuitToggle_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ConvertPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Convert" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Currencies, units and time zones. Select or copy something like $100, 5 km or 3 PM EST and Convert lights up, ready to convert. Choose your currencies and cities in the panel itself." />
                        <Border Style="{StaticResource Card}">
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="Currency rates by" />
                                <Hyperlink NavigateUri="https://www.exchangerate-api.com">ExchangeRate-API</Hyperlink>
                                <Run Text=", fetched at most every 12 hours and only when you open Convert." />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="NotesPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Quick notes" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Notes that save as you type and stay on this PC. Win+Alt+N opens them from anywhere." />
                    </StackPanel>

                    <StackPanel x:Name="ShelfPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Shelf" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Drop files anywhere on the rail to keep them handy, then drag them out wherever you need them. The shelf keeps links, so your files stay where they are." />
                    </StackPanel>

                    <StackPanel x:Name="CapturePage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Capture" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Take a screenshot, then copy its text, draw on it, pick a color, save it or add it to the shelf." />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Saved screenshots" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Pictures › Transom" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Click="OpenScreenshots_Click" Content="Open folder" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AwakePage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Keep awake" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Stops your PC from going to sleep for a while, for downloads, presentations or long tasks." />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Default duration" />
                                    <TextBlock Style="{StaticResource Hint}" Text="The duration picked when you open Keep awake." />
                                </StackPanel>
                                <ComboBox x:Name="AwakeBox" AutomationProperties.Name="Keep awake default duration" Grid.Column="1" MinWidth="120" VerticalAlignment="Center" SelectionChanged="AwakeBox_SelectionChanged">
                                    <x:String>30 min</x:String>
                                    <x:String>1 hour</x:String>
                                    <x:String>2 hours</x:String>
                                    <x:String>Until I stop it</x:String>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="RemindersPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Reminders" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Hint}" Text="Quick reminders that arrive as Windows notifications, with Snooze and Done buttons." />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Snooze length" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Used by the Snooze button on reminder notifications." />
                                </StackPanel>
                                <ComboBox x:Name="SnoozeBox" AutomationProperties.Name="Snooze length" Grid.Column="1" MinWidth="120" VerticalAlignment="Center" SelectionChanged="SnoozeBox_SelectionChanged">
                                    <x:String>5 min</x:String>
                                    <x:String>10 min</x:String>
                                    <x:String>15 min</x:String>
                                    <x:String>30 min</x:String>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PrivacyPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Privacy" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hide the rail from screenshots and recordings" />
                                    <TextBlock Style="{StaticResource Hint}" Text="The rail won't appear in screenshots, screen recordings or screen sharing. Useful when it shows your music or reminders." />
                                </StackPanel>
                                <ToggleSwitch x:Name="HideCaptureToggle" AutomationProperties.Name="Hide the rail from screenshots and recordings" Grid.Column="1" MinWidth="0" Toggled="HideCaptureToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="No telemetry" />
                                <TextBlock Style="{StaticResource Hint}" Text="Transom doesn't collect or send any usage data. The only internet request it makes is for currency rates, when you open Convert." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Your data stays on this PC" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Clipboard history, notes, reminders and shelf links are saved only on this PC. Passwords from password managers are never saved." />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Click="OpenData_Click" Content="Open data folder" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutPage" Spacing="6" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="About" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="64" Height="64" Source="Assets/Square150x150Logo.scale-200.png" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Transom" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="A slim bar on the edge of your screen for media, clipboard, notes and more." />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Credits" />
                                <TextBlock Style="{StaticResource Hint}">
                                    <Run Text="Currency rates by" />
                                    <Hyperlink NavigateUri="https://www.exchangerate-api.com">ExchangeRate-API</Hyperlink>
                                    <Run Text="." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Text="Built with WinUI 3 and .NET." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Source code" />
                                    <TextBlock Style="{StaticResource Hint}" Text="github.com/nisheet-n/transom" />
                                </StackPanel>
                                <HyperlinkButton Grid.Column="1" VerticalAlignment="Center" Content="Open on GitHub" NavigateUri="https://github.com/nisheet-n/transom" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
