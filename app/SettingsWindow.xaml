<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Transom.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Transom.Models"
    Title="Transom Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Transom Settings">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="780" Padding="28,4,28,28" Spacing="6">
                <TextBlock Margin="0,4,0,14" Style="{StaticResource TitleTextBlockStyle}" Text="Appearance" />

                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Rail background" />
                <TextBlock
                    Margin="0,0,0,6"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Changes show on the rail right away." />

                <GridView
                    x:Name="StyleGrid"
                    ItemsSource="{x:Bind Styles}"
                    SelectionChanged="StyleGrid_SelectionChanged"
                    SelectionMode="Single">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:StyleOption">
                            <StackPanel Width="164" Padding="6" Spacing="6">
                                <Border
                                    Height="60"
                                    Background="{x:Bind Swatch}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6" />
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <TextBlock
                                    Height="34"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Hint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel x:Name="PresetPanel" Margin="0,8,0,0" Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Preset color" />
                    <GridView
                        x:Name="PresetGrid"
                        ItemsSource="{x:Bind Presets}"
                        SelectionChanged="PresetGrid_SelectionChanged"
                        SelectionMode="Single">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:PresetOption">
                                <StackPanel Width="72" Padding="4" Spacing="6">
                                    <Ellipse
                                        Width="40"
                                        Height="40"
                                        HorizontalAlignment="Center"
                                        Fill="{x:Bind Swatch}"
                                        Stroke="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <Border x:Name="CustomPanel" Margin="0,8,0,0" Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Custom color" />
                        <ColorPicker
                            x:Name="CustomPicker"
                            ColorChanged="CustomPicker_ColorChanged"
                            IsAlphaEnabled="False"
                            IsColorChannelTextInputVisible="False"
                            IsHexInputVisible="True"
                            IsMoreButtonVisible="False" />
                        <Slider
                            x:Name="OpacitySlider"
                            Header="Opacity"
                            Maximum="100"
                            Minimum="10"
                            StepFrequency="5"
                            ValueChanged="OpacitySlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,18,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="More" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Rail theme" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Light or dark rail and icons. Follow taskbar uses your Windows mode." />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeBox"
                            Grid.Column="1"
                            MinWidth="160"
                            VerticalAlignment="Center"
                            SelectionChanged="ThemeBox_SelectionChanged">
                            <x:String>Follow taskbar</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Go solid on battery saver" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Turns off transparency to save power, like Windows does." />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="BatteryToggle"
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="BatteryToggle_Toggled" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
